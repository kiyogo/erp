# Default API. Leave as /api/v1 in development to use Vite's proxy.
VITE_API_URL=/api/v1
VITE_STORAGE_MODE=kiyo_cloud

# Optional endpoint overrides. They are selected by the runtime config layer and do not change the UI.
VITE_KIYO_CLOUD_API_URL=/api/v1
VITE_SELF_HOSTED_API_URL=https://self-hosted.example/api/v1
VITE_LOCAL_API_URL=http://127.0.0.1:3011/api/v1
