# Required in production. Development creates a private local secret in data/.
JWT_SECRET=
# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/appdnt
# Alternatively specify individual PG parameters:
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=appdnt
# PGUSER=postgres
# PGPASSWORD=your_password
# PGSSL=false

# Optional but recommended: encrypts the SMTP app password stored by Admin/System.
MAIL_CONFIG_ENCRYPTION_KEY=
# Public URL embedded in account-activation emails when no portal URL is saved in Admin/System.
PORTAL_BASE_URL=
# Enables the Google account-link button in the activation screen.
GOOGLE_CLIENT_ID=
# Same Google OAuth web-client ID exposed to the Vite activation screen.
VITE_GOOGLE_CLIENT_ID=
