PORT=3001
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=kiyovn_jwt_secret_change_me_in_production
ENCRYPTION_KEY=
KIYOVN_DATA_DIR=./data
KIYOVN_DB_PATH=./data/kiyovn.sqlite
CORS_ORIGIN=http://localhost:3011
# DATABASE_URL=postgres://postgres:postgres123@localhost:5432/appdnt

# Tài khoản quản trị đầu tiên: dùng npm run seed:admin (cần SEED_ADMIN_EMAIL và SEED_ADMIN_PASSWORD).
# Chỉ đặt true tạm thời cho lần khởi tạo đầu để cho phép lần đăng nhập đầu tiên tự tạo quản trị viên; sau đó xóa dòng này.
# KIYOVN_ALLOW_BOOTSTRAP_ADMIN=true

# Khóa truy cập (passkey): trang web phải chạy ở một trong các nguồn gốc được liệt kê. Mặc định dùng CORS_ORIGIN và mọi địa chỉ localhost.
# WEBAUTHN_ORIGINS=https://erp.congty.vn
# WEBAUTHN_RP_ID=erp.congty.vn
