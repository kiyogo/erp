# Network
KIYO_API_HOST=127.0.0.1
KIYO_API_PORT=3001

# Persistent data. Use PostgreSQL in the production deployment profile after the API parity migration.
KIYO_API_DB_PATH=./data/kiyo-cloud.sqlite
KIYO_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Required for a first production start. This account owns bootstrap administration.
KIYO_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
KIYO_BOOTSTRAP_ADMIN_PASSWORD=replace-this-before-production
